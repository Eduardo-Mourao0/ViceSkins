# Copie para .env e preencha. O docker compose lê o .env automaticamente.
# Nada aqui é obrigatório para o modo demonstração (docker compose run --rm seed).

# Login real com a Steam: https://steamcommunity.com/dev/apikey (domínio: localhost)
STEAM_API_KEY=

# Opcional em dev (o compose tem um valor padrão). Mínimo de 32 caracteres.
JWT_SECRET=

# Opcional. Para onde o navegador vai depois do login com a Steam.
# AUTH_REDIRECT_URL=http://localhost:3000/inventory

# Login sem Steam nas contas demo da seed (padrão: true no compose). Nunca em produção.
# DEV_LOGIN=true

# Taxa da plataforma em basis points (200 = 2%).
# PLATFORM_FEE_BPS=200

# Proteção de troca antes de pagar o vendedor. A da Steam é 7 dias;
# em dev, algo como 1m deixa ver o ciclo da compra inteiro.
# TRADE_HOLD_DURATION=168h

# Simulação: tempo até a oferta de troca ser "aceita".
# SIM_TRADE_ACCEPT_AFTER=15s
