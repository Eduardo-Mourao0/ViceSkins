# Copie para .env e preencha. O docker compose lê o .env automaticamente.

# https://steamcommunity.com/dev/apikey (domínio: localhost)
STEAM_API_KEY=

# Opcional em dev (o compose tem um valor padrão). Mínimo de 32 caracteres.
JWT_SECRET=

# Opcional. Para onde o navegador vai depois do login.
# AUTH_REDIRECT_URL=http://localhost:3000
