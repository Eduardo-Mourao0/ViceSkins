# Copie para .env e preencha. O docker compose lê o .env automaticamente.
# Para produção, use deploy/.env.prod.example.

# Obrigatória: login com a Steam: https://steamcommunity.com/dev/apikey (domínio: localhost)
STEAM_API_KEY=

# Opcional em dev (o compose tem um valor padrão). Mínimo de 32 caracteres.
JWT_SECRET=

# Opcional. Para onde o navegador vai depois do login com a Steam.
# AUTH_REDIRECT_URL=http://localhost:3000/inventory

# Taxa da plataforma em basis points (200 = 2%).
# PLATFORM_FEE_BPS=200

# Proteção de troca antes de pagar o vendedor. A da Steam é 7 dias;
# em dev, algo como 1m deixa ver o ciclo da compra inteiro.
# TRADE_HOLD_DURATION=168h

# Simulação: tempo até a oferta de troca ser "aceita".
# SIM_TRADE_ACCEPT_AFTER=15s

# Prazos das etapas da entrega. Perdeu o prazo → compra cancelada e estornada.
# SELLER_SEND_TIMEOUT=12h
# BUYER_ACCEPT_TIMEOUT=12h

# Verificação das trocas: simulated (padrão) ou steam.
# steam = P2P real e híbrido: confere os inventários públicos de vendedor e
# comprador e, se o vendedor cadastrou a API key, acompanha a oferta também.
# TRADE_PROVIDER=simulated
# Intervalo entre verificações de cada troca (padrão: 5s simulado, 2m steam).
# TRADE_CHECK_INTERVAL=2m

# Chave mestra que criptografa as API keys dos vendedores (base64 de 32 bytes).
# Obrigatória com TRADE_PROVIDER=steam. Gere com: openssl rand -base64 32
# SECRETS_KEY=

# Admins (resolvem disputas de entrega tardia): SteamID64 separados por vírgula.
# ADMIN_STEAM_IDS=
