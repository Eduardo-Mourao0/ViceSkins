# Produção (docker-compose.prod.yml). Copie para .env na raiz e preencha.
# NUNCA commite o .env.

# Domínio apontando (registro A) para o IP da máquina. O Caddy emite o HTTPS.
DOMAIN=viceskins.exemplo.com

# Senha do Postgres. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Assina os cookies de sessão. Mínimo de 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=

# https://steamcommunity.com/dev/apikey, registrada com o mesmo DOMAIN.
STEAM_API_KEY=

# Criptografa as API keys dos vendedores (base64 de 32 bytes). Gere com: openssl rand -base64 32
# Perder esta chave = os vendedores precisam cadastrar a API key de novo.
SECRETS_KEY=

# Quem resolve disputas: seu SteamID64 (17 dígitos), separados por vírgula.
ADMIN_STEAM_IDS=

# Opcionais
# PLATFORM_FEE_BPS=200
# TRADE_HOLD_DURATION=168h
# SELLER_SEND_TIMEOUT=12h
# BUYER_ACCEPT_TIMEOUT=12h
